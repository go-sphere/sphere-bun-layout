{
  "schema_version": 1,
  "name": "bun",
  "upstream": {
    "repository": "https://github.com/go-sphere/sphere-bun-layout.git",
    "ref": "master",
    "module": "github.com/go-sphere/sphere-bun-layout"
  },
  "capabilities": [
    "protobuf",
    "stdx-http",
    "bun",
    "wire",
    "swagger",
    "password-auth"
  ],
  "ownership": {
    "layout_owned": [
      ".github/workflows/**",
      ".dockerignore",
      ".gitignore",
      ".sphere/layout.json",
      "AGENTS.md",
      "CONTRIBUTING.md",
      "LICENSE",
      "buf.gen.yaml",
      "buf.binding.yaml",
      "buf.yaml",
      "cmd/app/Dockerfile",
      "cmd/tools/**",
      "codegen.versions",
      "docs/LAYOUT_CONTRACT.md",
      "docs/docs.*.go",
      "internal/pkg/app/**",
      "internal/pkg/httpsrv/**",
      "scripts/**"
    ],
    "mixed": [
      "Makefile",
      "go.mod",
      "cmd/app/builder.go",
      "cmd/app/main.go",
      "cmd/app/wire.go",
      "internal/config/**",
      "internal/wire.go",
      "internal/*/wire.go",
      "internal/server/*/web.go",
      "internal/pkg/database/**",
      "internal/service/api/**",
      "proto/api/**",
      "proto/bunpb/bunpb.proto"
    ],
    "generated": [
      "api/**",
      "build/**",
      "swagger/**",
      "var/**",
      "config.json",
      "config_gen.json",
      "buf.lock",
      "go.sum",
      "codegen.sha256",
      "cmd/app/wire_gen.go"
    ],
    "default": "project_owned"
  }
}
